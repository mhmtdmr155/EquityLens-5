# ==============================================================================
# EquityLens-5 | Git Ignore Rules
# ==============================================================================

# --- Python & Virtual Environments ---
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
# --- Build and Distribution Artifacts ---
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Python Tools & Caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# --- Node & Frontend ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
dist-ssr/
*.local

# --- Secret Configuration & Environment Files ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx

# --- Logs & Temporary Files ---
*.log
*.tmp
*.temp
logs/

# --- Local Databases & Data Stores ---
*.db
*.sqlite
*.sqlite3
data/*.db
data/*.sqlite
data/*.sqlite3
data/derived/*.csv
data/sec_cache/
data/market_cache/

# --- Operating System Artifacts ---
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
._*

# --- IDE & Editor Settings ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- Machine Learning Models & Heavy Artifacts ---
*.pt
*.pth
*.bin
*.onnx
*.safetensors
*.h5
*.keras
*.ckpt
*.joblib
*.pkl

# Model checkpoints
checkpoints/
ml/checkpoints/

# Note: CSV, JSON and sample configuration files are deliberately NOT blocked globally
# to allow versioning of small test data and schemas.

