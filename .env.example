# ==============================================================================
# EquityLens-5 | Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# DO NOT commit the .env file to Git or share it publicly.

# --- Alpaca Market Data API Credentials ---
# Register for free at https://app.alpaca.markets/signup
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# --- SEC EDGAR Fair Access Configuration ---
# Format: Sample Company Name AdminContact@<sample company domain>.com
# Provide your legitimate academic/personal email address.
SEC_USER_AGENT=

# --- PostgreSQL Database Configuration ---
# Format: postgresql+psycopg://username:password@localhost:5432/equitylens
DATABASE_URL=

